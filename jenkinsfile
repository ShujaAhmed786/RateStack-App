@Library('jenkins-shared-library@main') _

pipeline {
    agent any

    environment {
        DOCKERHUB_CREDENTIALS = 'dockerhub-creds'
        DOCKER_IMAGE_NAME     = 'shujaahmed198/ratestack-app'
        SONAR_SERVER_NAME     = 'SonarQube'
        SONAR_SCANNER_TOOL    = 'sonar-scanner'
        SONAR_PROJECT_KEY     = 'ratestack'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Security & Code Analysis') {
            parallel {
                stage('SAST') {
                    steps {
                        runSonarQube(
                            serverName: env.SONAR_SERVER_NAME,
                            scannerName: env.SONAR_SCANNER_TOOL,
                            projectKey: env.SONAR_PROJECT_KEY,
                            sources: 'src'
                        )
                    }
                }
                stage('SCA') {
                    steps {
                        runDependencyCheck(
                            target: 'package.json',
                            toolName: 'DP-Check'
                        )
                    }
                }
            }
        }

        stage('Containerize & Scan') {
            steps {
                buildAndScanDocker(
                    imageName: env.DOCKER_IMAGE_NAME,
                    dockerHubCredentials: env.DOCKERHUB_CREDENTIALS
                )
            }
        }

        stage('Kind Deployment') {
            steps {
                deployToKind(
                    deploymentName: 'ratestack-deployment',
                    namespace: 'default',
                    imageName: "${env.DOCKER_IMAGE_NAME}:${env.BUILD_NUMBER}"
                )
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "DevSecOps pipeline completed successfully. ArgoCD will track the new rollout."
        }
        failure {
            echo "Pipeline failed. Review security reports or build logs."
        }
    }
}